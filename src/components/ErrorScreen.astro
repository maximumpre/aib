---
/**
 * Chrome-Style ErrorScreen (Steins Gate standard)
 * Renders pixel-perfect dark Chrome "This site can't be reached" error screen.
 */
interface Props {
  id?: string;
  hidden?: boolean;
}

const { id = "chrome-error-screen", hidden = false } = Astro.props;
---

<div
  id={id}
  class="chrome-error-screen"
  hidden={hidden}
  style="display: none;"
>
  <div class="chrome-error-container">
    <div class="chrome-error-content">
      <img
        src="/error-icon.png"
        alt=""
        aria-hidden="true"
        class="chrome-error-icon"
        width="72"
        height="72"
      />

      <h1 class="chrome-error-title">
        This site can't be reached
      </h1>
      <p class="chrome-error-desc">
        <b class="chrome-error-host"></b> took too long to respond.
      </p>

      <p class="chrome-error-try">Try:</p>

      <ul class="chrome-error-list">
        <li>Checking the connection</li>
        <li class="chrome-error-link">
          Checking the proxy, firewall, and DNS configuration
        </li>
        <li class="chrome-error-link">
          Running Windows Network Diagnostics
        </li>
      </ul>

      <p class="chrome-error-code">ERR_NAME_NOT_RESOLVED</p>

      <div class="chrome-error-actions">
        <button
          type="button"
          class="chrome-error-btn-reload"
          id="chrome-error-reload-btn"
        >
          Reload
        </button>
        <button
          type="button"
          class="chrome-error-btn-details"
          id="chrome-error-details-btn"
        >
          Details
        </button>
      </div>

      <div class="chrome-error-details" id="chrome-error-details-panel" hidden>
        <div class="chrome-error-detail-block">
          <h2>Check your Internet connection</h2>
          <p>
            Check any cables and reboot any routers, modems, or other network devices you may be using.
          </p>
        </div>

        <div class="chrome-error-detail-block">
          <h2>Allow Chrome to access the network in your firewall or antivirus settings.</h2>
          <p>
            If it is already listed as a program allowed to access the network, try removing it from the list and adding it again.
          </p>
        </div>

        <div class="chrome-error-detail-block">
          <h2>If you use a proxy server...</h2>
          <p>
            Check your proxy settings or contact your network administrator to make sure the proxy server is working. If you don't believe you should be using a proxy server: Go to the Chrome menu &gt; Settings &gt; Show advanced settings... &gt; Change proxy settings... &gt; LAN Settings and deselect "Use a proxy server for your LAN".
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .chrome-error-screen {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background-color: #202124 !important;
    color: #9AA0A6 !important;
    font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, "Roboto", sans-serif !important;
    -webkit-font-smoothing: antialiased !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    overscroll-behavior: none !important;
    z-index: 999999 !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .chrome-error-container {
    width: 100% !important;
    max-width: 672px !important;
    margin: 0 auto !important;
    padding: 96px 24px 64px 24px !important;
    box-sizing: border-box !important;
  }

  .chrome-error-content {
    width: 100% !important;
    text-align: left !important;
  }

  .chrome-error-icon {
    display: block !important;
    margin-bottom: 32px !important;
    width: 72px !important;
    height: 72px !important;
    image-rendering: pixelated !important;
    image-rendering: -moz-crisp-edges !important;
    image-rendering: crisp-edges !important;
  }

  .chrome-error-title {
    font-size: 24px !important;
    font-weight: 600 !important;
    color: #E8EAED !important;
    margin: 0 0 16px 0 !important;
    line-height: 1.3 !important;
    letter-spacing: normal !important;
  }

  .chrome-error-desc {
    font-size: 15px !important;
    margin: 0 0 16px 0 !important;
    color: #9AA0A6 !important;
    line-height: 1.5 !important;
  }

  .chrome-error-desc b {
    color: #E8EAED !important;
    font-weight: 600 !important;
  }

  .chrome-error-try {
    font-size: 14px !important;
    margin: 0 0 8px 0 !important;
    color: #9AA0A6 !important;
  }

  .chrome-error-list {
    margin: 0 0 24px 0 !important;
    padding-left: 28px !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #9AA0A6 !important;
    list-style-type: disc !important;
  }

  .chrome-error-link {
    color: #8ABFF8 !important;
    cursor: pointer !important;
  }

  .chrome-error-code {
    font-size: 12px !important;
    color: #9AA0A6 !important;
    margin: 24px 0 36px 0 !important;
    letter-spacing: 0.5px !important;
  }

  .chrome-error-actions {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 16px !important;
    margin-top: 36px !important;
  }

  .chrome-error-btn-reload,
  .chrome-error-btn-details {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
    line-height: 1 !important;
    padding: 0 24px !important;
    margin: 0 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    font-family: inherit !important;
    letter-spacing: 0.25px !important;
    text-align: center !important;
    vertical-align: middle !important;
    cursor: pointer !important;
    outline: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    white-space: nowrap !important;
    text-decoration: none !important;
    border-radius: 9999px !important;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease !important;
  }

  .chrome-error-btn-reload {
    background-color: #8ABFF8 !important;
    color: #202124 !important;
    border: none !important;
  }

  .chrome-error-btn-reload:hover {
    background-color: #A6D0F9 !important;
    color: #202124 !important;
  }

  .chrome-error-btn-reload:active {
    background-color: #7BAAF7 !important;
    color: #202124 !important;
  }

  .chrome-error-btn-details {
    background: transparent !important;
    color: #8ABFF8 !important;
    border: 1px solid #5F6368 !important;
  }

  .chrome-error-btn-details:hover {
    background-color: #303339 !important;
    border-color: #8ABFF8 !important;
    color: #8ABFF8 !important;
  }

  .chrome-error-btn-details:active {
    background-color: #3C4043 !important;
    color: #8ABFF8 !important;
  }

  .chrome-error-details {
    margin-top: 36px !important;
    padding-top: 24px !important;
    border-top: 1px solid #3C4043 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 20px !important;
  }

  .chrome-error-details[hidden],
  .chrome-error-details.is-hidden {
    display: none !important;
  }

  .chrome-error-detail-block h2 {
    font-size: 15px !important;
    font-weight: 600 !important;
    color: #E8EAED !important;
    margin: 0 0 6px 0 !important;
    line-height: 1.4 !important;
  }

  .chrome-error-detail-block p {
    font-size: 13px !important;
    line-height: 1.5 !important;
    color: #9AA0A6 !important;
    margin: 0 !important;
  }
</style>

<script is:inline>
  (function initChromeErrorScreen() {
    function setup() {
      var hostEls = document.querySelectorAll('.chrome-error-host');
      var currentHost = window.location.hostname || 'This site';
      for (var i = 0; i < hostEls.length; i++) {
        hostEls[i].textContent = currentHost;
      }

      var reloadBtn = document.getElementById('chrome-error-reload-btn');
      if (reloadBtn && !reloadBtn.dataset.bound) {
        reloadBtn.dataset.bound = 'true';
        reloadBtn.addEventListener('click', function (e) {
          e.preventDefault();
          window.location.reload();
        });
      }

      var detailsBtn = document.getElementById('chrome-error-details-btn');
      var detailsPanel = document.getElementById('chrome-error-details-panel');
      if (detailsBtn && detailsPanel && !detailsBtn.dataset.bound) {
        detailsBtn.dataset.bound = 'true';

        // Ensure initially hidden state
        detailsPanel.setAttribute('hidden', '');
        detailsPanel.classList.add('is-hidden');
        detailsBtn.textContent = 'Details';

        detailsBtn.addEventListener('click', function (e) {
          e.preventDefault();
          var isHidden = detailsPanel.hasAttribute('hidden') || detailsPanel.classList.contains('is-hidden');
          if (isHidden) {
            detailsPanel.removeAttribute('hidden');
            detailsPanel.classList.remove('is-hidden');
            detailsBtn.textContent = 'Hide details';
          } else {
            detailsPanel.setAttribute('hidden', '');
            detailsPanel.classList.add('is-hidden');
            detailsBtn.textContent = 'Details';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
